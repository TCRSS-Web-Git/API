includes:
    - vendor/larastan/larastan/extension.neon

parameters:

    paths:
        - app/
        - database/
        - routes/

    # Level 9 is the highest level
    level: 5

    #    ignoreErrors:
    #        - '#PHPDoc tag @var#'
    #

    excludePaths:
        - ./app/Http/Controllers/Auth/VerifyEmailController.php
        - ./routes/console.php
